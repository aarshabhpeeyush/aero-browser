# Aeris: Firefox built for Windows (x64) on a Linux computer in GitHub's cloud.
ac_add_options --target=x86_64-pc-windows-msvc
ac_add_options --enable-bootstrap

ac_add_options --with-branding=browser/branding/aeris
ac_add_options --with-app-name=aeris
ac_add_options --with-app-basename=Aeris

ac_add_options --enable-release
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-tests
ac_add_options --disable-crashreporter
ac_add_options --disable-maintenance-service
# Aeris checks GitHub for updates itself (like Aero did), so Mozilla's updater isn't built.
ac_add_options --disable-updater

# Reuse compiled pieces between builds in the cloud.
ac_add_options --with-ccache=sccache

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-aeris
export MOZ_TELEMETRY_REPORTING=
export MOZ_REQUIRE_SIGNING=
